# ===== Copiar a deploy/aws/env y completar con las IP PRIVADAS de las VM =====
MDS1_IP=10.0.1.10
MDS2_IP=10.0.2.10
MDS3_IP=10.0.3.10
GATEWAY_IP=10.0.1.5
DN1_IP=10.0.1.21
DN2_IP=10.0.2.22
DN3_IP=10.0.3.23
DN4_IP=10.0.1.24
DN5_IP=10.0.2.25
DN1_ZONE=a
DN2_ZONE=b
DN3_ZONE=c
DN4_ZONE=a
DN5_ZONE=b
# puertos
RAFT_PORT=7000
REST_PORT=8443
MDS_GRPC_PORT=9444
DN_PORT=9443       # puerto de cliente (TLS + token); el puerto de nodo (mTLS) es DN_PORT+1 = 9444
# parámetros de producción del diseño
DFSHA_BLOCK_SIZE=67108864
DFSHA_HB_S=3
DFSHA_SUSPECT_S=10
DFSHA_DEAD_S=30
DFSHA_GRACE_S=600
# auto: un DN con certificado válido de la CA se registra solo | admin: requiere 'dfsha admin add dn-N'
DFSHA_DN_ADMISSION=auto
DFSHA_REBALANCE=1
DFSHA_USERS=alice:CAMBIAR1,bob:CAMBIAR2,admin:CAMBIAR3:admin
# Raft ya viaja por mTLS; la contraseña de PySyncObj es una segunda capa (opcional)
DFSHA_RAFT_PASSWORD=CAMBIAR-clave-raft
